# ======================================
# 错题管理系统配置文件
# ======================================

# ======================================
# 主服务配置
# ======================================
HOST=0.0.0.0
PORT=8000

# ======================================
# 数据库配置
# ======================================
DATABASE_URL=sqlite:///./wrong_question.db

# ======================================
# PDF解析服务配置
# ======================================

# 部署模式: local(本地) 或 remote(云端)
PDF_PARSER_MODE=local

# 是否自动启动PDF解析服务（仅local模式有效）
PDF_PARSER_AUTO_START=true

# PDF解析服务地址
# 本地模式: http://localhost:8001
# 云端模式: http://your-server.com:8001
PDF_PARSER_URL=http://localhost:8001

# PDF解析服务端口（仅local模式有效）
PDF_PARSER_PORT=8001

# PDF解析超时时间（秒）
PDF_PARSER_TIMEOUT=300

# ======================================
# 文件上传配置
# ======================================
MAX_UPLOAD_SIZE=52428800
UPLOAD_FOLDER=static/uploads

# ======================================
# 导出配置
# ======================================
EXPORT_SETTINGS_FOLDER=static/export_settings
MAX_EXPORT_FILES=20
EXPORT_FILE_LIFETIME=3600
